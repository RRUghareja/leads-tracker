{
  "name": "leads-tracker",
  "version": "1.0.0",
  "private": true,
  "description": "Leads tracking app: Express + SQLite API and a Next.js web portal",
  "workspaces": [
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev -w apps/api\" \"npm:dev -w apps/web\"",
    "build": "npm run build -w apps/api && npm run build -w apps/web",
    "start": "concurrently -n api,web -c blue,green \"npm:start -w apps/api\" \"npm:start -w apps/web\"",
    "test": "npm test -w apps/api",
    "typecheck": "npm run typecheck -w apps/api && npm run typecheck -w apps/web",
    "format": "prettier --write \"apps/**/*.{ts,tsx,css,json}\" \"*.{json,md}\"",
    "seed": "npm run seed -w apps/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.4",
    "prettier": "^3.9.8",
    "typescript": "^5.9.3"
  }
}
