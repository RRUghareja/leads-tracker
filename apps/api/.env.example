# Copy to .env to override defaults. Every value below is optional.
NODE_ENV=development
PORT=4000
DATABASE_PATH=data/leads.db
CORS_ORIGIN=http://localhost:3000

# Login (HTTP Basic auth) for every /api route except /api/health.
# It is ON by default with the demo login  admin / admin123.
#   - To use your own login, set BOTH of these:
BASIC_AUTH_USER=
BASIC_AUTH_PASSWORD=
#   - To turn the login off completely:
# BASIC_AUTH_ENABLED=false
