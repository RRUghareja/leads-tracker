# Copy to .env.local to override defaults. Every value below is optional.

# Where the Express API lives. Only the Next.js server talks to it (never the browser).
API_URL=http://localhost:4000

# The login this web server sends to the API. Only needed when the API has
# BASIC_AUTH_USER / BASIC_AUTH_PASSWORD set.
API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASSWORD=

# Protect the web portal itself: when both are set, the browser asks for this login before showing
# any page. Leave both empty for no login.
PORTAL_BASIC_AUTH_USER=
PORTAL_BASIC_AUTH_PASSWORD=
