# Copy to .env.local to override defaults. Every value below is optional.

# Where the Express API lives. Only the Next.js server talks to it (never the browser).
API_URL=http://localhost:4000

# --- Sign-in popup for the web portal ------------------------------------------------------------
# Opening any page while signed out shows a login popup. It is ON by default with the demo login
#   admin@gmail.com / admin123
#   - To use your own login, set BOTH of these:
PORTAL_LOGIN_USER=
PORTAL_LOGIN_PASSWORD=
#   - To turn the portal login off completely:
# PORTAL_LOGIN_ENABLED=false

# --- Login this web server uses when it calls the API -------------------------------------------
# Defaults to admin@gmail.com / admin123, which is what the API expects when it is not configured either.
# Only set these if you gave the API its own BASIC_AUTH_USER / BASIC_AUTH_PASSWORD.
API_BASIC_AUTH_USER=
API_BASIC_AUTH_PASSWORD=
